---
import { site } from '@/data/site';
interface Props { iconsOnly?: boolean; includeEmail?: boolean; }
const { iconsOnly = false, includeEmail = true } = Astro.props;
const availableLinks = site.socialLinks.filter((link) => link.href && (includeEmail || link.label !== 'E-mail'));
---

<div class:list={['social-links', { 'social-links-icons': iconsOnly }]} aria-label="Links acadêmicos e profissionais">
  {availableLinks.map((link) => (
    <a href={link.href} aria-label={iconsOnly ? link.label : undefined} title={iconsOnly ? link.label : undefined} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel={link.href.startsWith('mailto:') ? undefined : 'noreferrer'}>
      {link.label === 'GitHub' && <svg class="social-icon-fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.2 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.7-2.3 4.5-4.6 4.7.4.3.7 1 .7 1.9v2.8c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5Z" /></svg>}
      {link.label === 'Lattes' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-5 9 5-9 5-9-5Z" /><path d="M7 12v4.5c2.7 2 7.3 2 10 0V12M21 9v6" /></svg>}
      {link.label === 'Google Scholar' && <svg class="social-icon-fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 9l4 2.4V17l6 4 6-4v-5.6l2-1.2V17h2V9L12 3Zm4 13-4 2.7L8 16v-3.4l4 2.4 4-2.4V16Z" /></svg>}
      {link.label === 'ORCID' && <svg class="social-icon-fill" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path fill="var(--color-bg)" d="M8 7.2h1.3v1.3H8V7.2Zm0 2.5h1.3v7H8v-7Zm3.1-2.5h3c3.5 0 5 2.5 5 4.8s-1.5 4.8-5 4.8h-3V7.2Zm1.4 1.3v7h1.7c2.3 0 3.5-1.4 3.5-3.5s-1.2-3.5-3.5-3.5h-1.7Z" /></svg>}
      {link.label === 'LinkedIn' && <svg class="social-icon-fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.1 7.6A1.6 1.6 0 1 0 5.1 4.4a1.6 1.6 0 0 0 0 3.2ZM3.7 9h2.8v9.3H3.7V9Zm4.6 0h2.7v1.3c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7v4.9h-2.8V14c0-1 0-2.4-1.5-2.4s-1.7 1.1-1.7 2.3v4.4H8.3V9Z" /></svg>}
      {link.label === 'E-mail' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>}
      {!iconsOnly && <span>{link.label}</span>}
    </a>
  ))}
</div>
