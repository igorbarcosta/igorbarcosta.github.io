---
import type { CollectionEntry } from 'astro:content';
import { formatSupervisionCourse, formatSupervisionPeriod } from '@/lib/site';

interface Props {
  supervision: CollectionEntry<'supervision'>;
  peopleFirst?: boolean;
}

const { supervision, peopleFirst = false } = Astro.props;
const data = supervision.data;
const students = [...data.students].sort((a: string, b: string) => a.localeCompare(b, 'pt-BR'));
const participants = students.length ? students : data.team ? [data.team] : [];
const Heading = peopleFirst ? 'h4' : 'h3';
const period = formatSupervisionPeriod(data);
const formatCommitteeRole = (role: string) => role.charAt(0).toLocaleUpperCase('pt-BR') + role.slice(1);
const formatDefenseDate = (date: Date) => new Intl.DateTimeFormat('pt-BR', { timeZone: 'UTC' }).format(date);
---

<li class="supervision-item">
  <details class="committee-entry supervision-entry" id={supervision.id}>
    <summary>
      <span class="committee-summary">
        <Heading class:list={{ 'committee-student-names': peopleFirst && participants.length > 1 }}>
          {peopleFirst ? participants.map((student) => <span>{student}</span>) : data.title}
        </Heading>
        {peopleFirst && <p class="record-title">{data.title}</p>}
        <div class="supervision-subline">
          {!peopleFirst && <span class:list={{ 'committee-students': true, 'student-list-many': students.length > 2 }}>
            {participants.map((student: string) => <span>{student}</span>)}
          </span>}
          {data.course && <>
            {!peopleFirst && <span class="supervision-subline-sep" aria-hidden="true">·</span>}
            <span class="supervision-course">{formatSupervisionCourse(data.course)}</span>
          </>}
        </div>
        <div class="card-meta-row card-meta-bottom">
          {period && <time class="entry-note">{period}</time>}
          {data.role && <span class="entry-note">{data.role}</span>}
        </div>
      </span>
      <span class="committee-toggle" aria-hidden="true">
        <span class="committee-toggle-more">Ver detalhes</span>
        <span class="committee-toggle-less">Ocultar detalhes</span>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
      </span>
    </summary>
    <dl class="committee-details supervision-details">
      {data.course && <div>
        <dt>Curso</dt>
        <dd>{formatSupervisionCourse(data.course)}</dd>
      </div>}
      {data.team && <div><dt>Equipe</dt><dd>{data.team}</dd></div>}
      <div><dt>Instituição</dt><dd>{data.institution}</dd></div>
      {period && <div>
        <dt>Período de orientação</dt>
        <dd>{period}</dd>
      </div>}
      {data.defense && <div>
        <dt>Banca examinadora</dt>
        <dd>{data.defense.committee.map((member: { name: string; role: string }) => <span>{member.name} ({formatCommitteeRole(member.role)})</span>)}</dd>
      </div>}
      {data.qualification && <>
        <div>
          <dt>Data da qualificação</dt>
          <dd><time datetime={data.qualification.date.toISOString()}>{formatDefenseDate(data.qualification.date)}</time></dd>
        </div>
        <div>
          <dt>Banca de qualificação</dt>
          <dd>{data.qualification.committee.map((member) => <span>{member.name} ({formatCommitteeRole(member.role)})</span>)}</dd>
        </div>
        <div><dt>Resultado da qualificação</dt><dd>{data.qualification.outcome}</dd></div>
      </>}
      {data.defense && <div>
        <dt>Data da defesa</dt>
        <dd><time datetime={data.defense.date.toISOString()}>{formatDefenseDate(data.defense.date)}</time></dd>
      </div>}
      {!data.defense && data.advisor && <div>
        <dt>Orientação</dt>
        <dd>
          <span>{data.advisor} (Orientador)</span>
          {data.role === 'Coorientador' && <span>Ígor Barbosa da Costa (Coorientador)</span>}
        </dd>
      </div>}
      {data.repository && <div>
        <dt>Trabalho</dt>
        <dd><a class="repository-link" href={data.repository} target="_blank" rel="noreferrer" aria-label={`Abrir trabalho: ${data.title}`}>Abrir trabalho <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6m-1-5-8 8M19 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" /></svg></a></dd>
      </div>}
      {data.publication && /^https?:\/\//.test(data.publication) && <div>
        <dt>Publicação relacionada</dt>
        <dd><a href={data.publication} target="_blank" rel="noreferrer">Abrir publicação ↗</a></dd>
      </div>}
    </dl>
  </details>
</li>
