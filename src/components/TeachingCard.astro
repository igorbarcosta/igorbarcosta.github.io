---
import type { CollectionEntry } from 'astro:content';
interface Props { teaching: CollectionEntry<'teaching'>; }
const { teaching } = Astro.props;
const data = teaching.data;
const course = data.course?.startsWith('TODO:') ? undefined : data.course;
const institution = data.institution.startsWith('TODO:') ? undefined : data.institution;
const context = [course, institution, data.campus ? `Campus ${data.campus}` : undefined].filter(Boolean).join(' · ');
---
<article class="teaching-item">
  <div class="item-heading">
    <h3>{data.title}</h3>
    <span class="badge-mono">{data.semester}</span>
  </div>
  {context && <p class="teaching-context">{context}</p>}
  {(data.areas.length > 0 || data.classLevel || data.classHours || data.classes) && <div class="teaching-meta">
    {data.areas.map((area) => <span class="tag">{area}</span>)}
    {data.classLevel && <span class="tag">{data.classLevel}</span>}
    {data.classHours && <span class="tag">{data.classHours} h/a</span>}
    {data.classes && <span class="tag">{data.classes} {data.classes === 1 ? 'turma' : 'turmas'}</span>}
  </div>}
  {data.site && <a href={data.site} target="_blank" rel="noreferrer" class="teaching-link">Site da disciplina ↗</a>}
</article>
