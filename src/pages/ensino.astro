---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TeachingCard from '@/components/TeachingCard.astro';
import ActivityList from '@/components/ActivityList.astro';
import ArchiveYear from '@/components/ArchiveYear.astro';
import { teachingActivities } from '@/data/activities';

const teaching = (await getCollection('teaching')).sort((a, b) =>
  b.data.semester.localeCompare(a.data.semester) || a.data.title.localeCompare(b.data.title, 'pt-BR'));
const current = teaching.filter((entry) => entry.data.status === 'current' || entry.data.status === 'planned');
const history = teaching.filter((entry) => entry.data.status === 'completed' || entry.data.status === 'archived');
const groupedHistory = history.reduce<Record<string, typeof history>>((groups, entry) => {
  const year = entry.data.semester.split('.')[0];
  groups[year] ??= [];
  groups[year].push(entry);
  return groups;
}, {});
---

<BaseLayout title="Ensino" description="Disciplinas atuais e histórico docente de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Ensino</h1>
    <p>Disciplinas atuais, ofertas anteriores e outras atividades de ensino.</p>
    <nav class="page-shortcuts" aria-label="Ensino por período">
      <span class="shortcuts-label">Ensino</span>
      <a href="#ofertas-atuais">Ofertas atuais <span>{current.length}</span></a>
      <a href="#historico">Histórico <span>{history.length}</span></a>
    </nav>
  </section>

  <div class="academic-directory">
  <section class="section container" id="ofertas-atuais">
    <SectionHeading title="Ofertas atuais" />
    <div class="teaching-list">
      {current.length ? [...new Set(current.map((entry) => entry.data.semester))].map((semester) => <section class="record-group semester-group">
        <h3>{semester}</h3>
        <div class="teaching-course-grid">{current.filter((entry) => entry.data.semester === semester).map((entry) => <TeachingCard teaching={entry} showSemester={false} headingLevel="h4" />)}</div>
      </section>) : <div class="empty-state"><p>Nenhuma oferta atual cadastrada.</p></div>}
    </div>
  </section>

  <section class="section section-soft" id="historico">
    <div class="container">
      <SectionHeading title="Histórico por período" />
      {Object.keys(groupedHistory).length ? Object.entries(groupedHistory).sort(([a], [b]) => b.localeCompare(a)).map(([year, entries]) => (
        <ArchiveYear year={year} count={entries.length}>
          {[...new Set(entries.map((entry) => entry.data.semester))].map((semester) => <section class="record-group semester-group">
            <h3>{semester}</h3>
            <div class="teaching-course-grid">{entries.filter((entry) => entry.data.semester === semester).map((entry) => <TeachingCard teaching={entry} showSemester={false} headingLevel="h4" />)}</div>
          </section>)}
        </ArchiveYear>
      )) : <div class="empty-state"><p>O histórico docente será adicionado conforme as ofertas forem documentadas.</p></div>}
    </div>
  </section>

  {teachingActivities.length > 0 && <section class="section container">
    <SectionHeading title="Outras atividades de ensino" />
    <div class="record-group"><ActivityList items={teachingActivities.map((activity) => ({
      title: activity.title,
      context: [activity.institution, activity.course, activity.role].filter(Boolean).join(' · '),
      period: activity.semesters.length ? activity.semesters.join(' · ') : String(activity.year),
      details: activity.weeklyHours ? [{ label: 'Carga horária semanal', value: `${activity.weeklyHours} horas` }] : [],
    }))} /></div>
  </section>}
  </div>
</BaseLayout>
