---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ActivityList from '@/components/ActivityList.astro';
import ArchiveYear from '@/components/ArchiveYear.astro';
import { groupByYear } from '@/lib/archive';
import { institutional } from '@/data/institutional';
import { events, reviews } from '@/data/activities';
import { formatDate, formatPeriod, formatSupervisionCourse } from '@/lib/site';

const activities = institutional.activities.sort((a, b) => b.start.getTime() - a.start.getTime());
const committeeTime = (entry: typeof institutional.committees[number]) => entry.date?.getTime()
  ?? Date.UTC(Number(entry.semester?.slice(0, 4) ?? entry.year ?? 0), entry.semester?.endsWith('.2') ? 6 : 0);
const committees = institutional.committees.sort((a, b) => committeeTime(b) - committeeTime(a));
const committeeGroups = groupByYear(committees, (entry) => entry.date?.getUTCFullYear() ?? entry.year ?? entry.semester?.slice(0, 4));
const activityGroups = groupByYear(activities, (entry) => entry.start.getUTCFullYear());
const eventGroups = groupByYear(events, (entry) => entry.start?.getUTCFullYear() ?? entry.year);
const reviewGroups = groupByYear(reviews, (entry) => entry.year);
const committeePeriod = (entry: typeof committees[number]) => entry.date ? formatDefenseMonth(entry.date) : entry.semester ?? String(entry.year ?? '');
const formatDefenseMonth = (date: Date) => new Intl.DateTimeFormat('pt-BR', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date).replace('.', '');
const formatDefenseFull = (date: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
const formatCommitteeRole = (role: string) => role.charAt(0).toLocaleUpperCase('pt-BR') + role.slice(1);
---

<BaseLayout title="Atuações" description="Atividades institucionais e acadêmicas de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Atuações</h1>
    <p>Participações em bancas, colegiados, comissões, eventos e avaliação científica.</p>
    <nav class="section-index" aria-label="Atuações por categoria">
      <a href="#bancas">Bancas <span>{committees.length}</span></a>
      <a href="#institucional">Atuação institucional <span>{activities.length}</span></a>
      <a href="#eventos">Eventos <span>{events.length}</span></a>
      <a href="#revisoes">Revisões e avaliações <span>{reviews.length}</span></a>
    </nav>
  </section>

  <section class="section container academic-directory" id="bancas">
    <SectionHeading title="Participações em Bancas" description="Participações em bancas de avaliação de trabalhos acadêmicos." />
    {committeeGroups.map(([year, entries]) => <ArchiveYear year={year} count={entries.length}>
    {[...new Set(entries.map((committee) => committee.category))].map((category) => <section class="record-group">
    <h3>{category}</h3>
    <ul class="committee-list supervision-list">
      {entries.filter((committee) => committee.category === category).map((committee) => {
        const students = [...committee.students].sort((a, b) => a.localeCompare(b, 'pt-BR'));
        return <li>
          <details class="committee-entry">
            <summary>
              <span class="committee-summary">
                <h4>{students.length ? students.join(' · ') : committee.title}</h4>
                {students.length > 0 && <p class="record-title">{committee.title}</p>}
                <div class="supervision-subline">
                  {committee.course && (
                      <span class="supervision-course">{formatSupervisionCourse(committee.course)}</span>
                  )}
                </div>
                <div class="card-meta-row card-meta-bottom">
                  <span class="entry-note">{committee.role}</span>
                  {committeePeriod(committee) && <time class="entry-note">{committeePeriod(committee)}</time>}
                </div>
              </span>
              <span class="committee-toggle" aria-hidden="true">
                <span class="committee-toggle-more">Ver detalhes</span>
                <span class="committee-toggle-less">Ocultar detalhes</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
              </span>
            </summary>
            <dl class="committee-details supervision-details">
              {committee.course && <div>
                <dt>Curso</dt>
                <dd>{formatSupervisionCourse(committee.course)}</dd>
              </div>}
              {committee.date && <div>
                <dt>{committee.stage === 'qualificacao' ? 'Data da qualificação' : 'Data'}</dt>
                <dd><time datetime={committee.date.toISOString()}>{formatDefenseFull(committee.date)}</time></dd>
              </div>}
              {!committee.date && committeePeriod(committee) && <div>
                <dt>Período</dt><dd>{committeePeriod(committee)}</dd>
              </div>}
              <div>
                <dt>Atuação</dt>
                <dd>{committee.role}</dd>
              </div>
              {committee.institution && <div>
                <dt>Instituição</dt>
                <dd>{committee.institution}{committee.campus ? ` — Campus ${committee.campus}` : ''}</dd>
              </div>}
              {committee.committee.length > 0 && <div>
                <dt>Banca examinadora</dt>
                <dd>
                  {committee.committee.map((member) => <span>{member.name} ({formatCommitteeRole(member.role)})</span>)}
                </dd>
              </div>}
            </dl>
          </details>
        </li>;
      })}
    </ul>
    </section>)}
    </ArchiveYear>)}
  </section>

  <section class="section section-soft" id="institucional">
    <div class="container">
      <SectionHeading title="Atuação institucional" description="Comissões, colegiados, gestão acadêmica e desenvolvimento institucional." />
      {activityGroups.map(([year, entries]) => <ArchiveYear year={year} count={entries.length}>
      <ul class="supervision-list">
        {entries.map((activity) => <li>
          <article class="committee-entry institutional-card">
            <div class="committee-summary">
              <h3>{activity.title}</h3>
              <div class="supervision-subline">
                <span class="committee-students">{activity.role}</span>
                <span class="supervision-subline-sep" aria-hidden="true">·</span>
                <span class="supervision-course">{activity.category}</span>
              </div>
              <div class="card-meta-row card-meta-bottom">
                <span class="badge-mono">
                  {activity.end ? formatPeriod(activity.start, activity.end) : `Registro em ${formatDate(activity.start)}`}
                </span>
              </div>
            </div>
          </article>
        </li>)}
      </ul>
      </ArchiveYear>)}
    </div>
  </section>

  <section class="section container" id="eventos">
    <SectionHeading title="Eventos" description="Participações, apresentações e capacitações ministradas." />
    {eventGroups.map(([year, entries]) => <ArchiveYear year={year} count={entries.length}>
    <ActivityList items={entries.map((event) => ({
      title: event.title,
      context: [event.role, event.location].filter(Boolean).join(' · '),
      period: event.start
        ? event.end && event.start.getTime() !== event.end.getTime()
          ? `${formatDefenseFull(event.start)} – ${formatDefenseFull(event.end)}`
          : formatDefenseFull(event.start)
        : String(event.year),
      description: event.contribution,
      details: [
        { label: 'Organização', value: event.organization.join(' · ') },
        { label: 'Local', value: event.venue ?? '' },
        { label: 'Carga horária', value: event.hours ? `${event.hours} horas` : '' },
      ],
    }))} />
    </ArchiveYear>)}
  </section>

  <section class="section section-soft" id="revisoes">
    <div class="container">
      <SectionHeading title="Revisões e avaliações" description="Avaliação de trabalhos e projetos de pesquisa." />
      {reviewGroups.map(([year, entries]) => <ArchiveYear year={year} count={entries.length}>
      <ActivityList items={entries.map((review) => ({
        title: review.title,
        context: [review.role, review.location].filter(Boolean).join(' · '),
        period: review.date ? formatDefenseFull(review.date) : String(review.year),
      }))} />
      </ArchiveYear>)}
    </div>
  </section>
</BaseLayout>
