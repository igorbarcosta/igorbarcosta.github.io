---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import ActivityList from '@/components/ActivityList.astro';
import { site } from '@/data/site';
import { certifications, courses, professionalExperience } from '@/data/activities';
import { formatDate, formatPeriod, withBase } from '@/lib/site';
---

<BaseLayout title="Sobre" description="Formação e trajetória profissional de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Sobre</h1>
    <p>Formação e trajetória profissional.</p>
    <nav class="page-shortcuts" aria-label="Nesta página">
      <a href="#formacao">Formação <span>{site.profile.education.length}</span></a>
      <a href="#experiencia">Atuação profissional</a>
      <a href="#cursos">Cursos e certificações <span>{courses.length + certifications.length}</span></a>
      <a href="#reconhecimento">Prêmios e links</a>
    </nav>
  </section>

  <div class="academic-directory profile-records">
    <section class="section container" id="formacao">
      <SectionHeading title="Formação acadêmica" />
      <div class="education-grid">
        {site.profile.education.map((item) => <article class:list={['record-group', 'education-entry', { 'education-doctorate': item.id === 'doctorate-computer-science' }]}>
          <div class="education-heading">
            <p class="education-period">{item.period}</p>
            <div class="education-crests">
            {[item.institution, ...(site.educationAdditionalLogos[item.id] ?? [])].map((institution) => {
              const logo = site.educationLogos[institution];
              return logo && <div class="education-crest" title={institution} style={`--crest-scale: ${logo.scale}`}>
                <svg viewBox={logo.viewport.join(' ')} focusable="false">
                  <title>{institution}</title>
                  <image class:list={{ 'education-crest-white': logo.whiteArtwork }} href={withBase(logo.src)} width={logo.width} height={logo.height} />
                </svg>
              </div>;
            })}
            </div>
          </div>
          <h3>{item.degree}</h3>
          <p class="education-institution">{item.institution}</p>
          {item.detail && <p class="education-detail">{item.detail}</p>}
        </article>)}
      </div>
    </section>

    <section class="section container" id="experiencia">
      <SectionHeading title="Atuação profissional" />
      <div class="record-group">
        <div class="profile-affiliation-record">
          <h3>{site.profile.affiliation.institution}</h3>
          <p>{site.profile.affiliation.campus} · desde {site.profile.affiliation.since}</p>
        </div>
        <ActivityList items={professionalExperience.map((experience) => ({
          title: experience.title, context: experience.institution,
          period: formatPeriod(experience.start, experience.end), description: experience.role,
        }))} />
      </div>
    </section>

    <section class="section container" id="cursos">
      <SectionHeading title="Cursos e certificações" />
      <div class="record-group">
        <ActivityList items={[
          ...courses.map((course) => ({
            title: course.title, context: `${course.institution} · ${course.category}`,
            period: formatDate(course.date), href: course.url,
            details: [
              { label: 'Carga horária', value: course.hours ? `${course.hours} horas` : '' },
              { label: 'Conteúdo', value: course.syllabus.join(' · ') },
            ],
          })),
          ...certifications.map((certification) => ({
            title: certification.title, context: `${certification.institution} · ${certification.category}`,
            period: formatDate(certification.date),
          })),
        ]} />
      </div>
    </section>

    <section class="section container" id="idiomas">
      <SectionHeading title="Idiomas" />
      <div class="record-group">
        <dl class="profile-languages">{site.profile.languages.map((item) => <div><dt>{({ Inglês: 'gb', Alemão: 'de', Espanhol: 'es' }[item.language]) && <img class="language-flag" src={withBase(`/flags/${{ Inglês: 'gb', Alemão: 'de', Espanhol: 'es' }[item.language]}.svg`)} alt="" />} {item.language}</dt><dd>{item.level}</dd></div>)}</dl>
      </div>
    </section>

    <section class="section container" id="reconhecimento">
      <SectionHeading title="Prêmios e links" />
      <div class="record-group">
        <ul class="plain-list recognition-list">{site.profile.recognition.map((item) => <li><span>{item.year}</span> {item.title}</li>)}</ul>
        <div class="profile-links">
          <SocialLinks />
          <p class="entry-note">Currículo Lattes atualizado em {new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(site.profile.lattesUpdatedAt)}.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
