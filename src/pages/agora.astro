---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TeachingCard from '@/components/TeachingCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SupervisionItem from '@/components/SupervisionItem.astro';
import { site } from '@/data/site';
import { getCurrentAcademicActivities } from '@/lib/current';
import { formatSupervisionType, withBase } from '@/lib/site';

const { projects, teaching, supervision } = await getCurrentAcademicActivities();
const currentActivities = site.currentActivities.filter((activity) => activity.status === 'active');
const semesters = [...new Set(teaching.map((entry) => entry.data.semester))];
const supervisionTypes = [...new Set(supervision.map((entry) => entry.data.type))];
---

<BaseLayout title="Agora" description="Atividades atuais de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Agora</h1>
    <p>Disciplinas, projetos e orientações em andamento.</p>
    <nav class="page-shortcuts" aria-label="Atividades atuais">
      <a href="#ensino">Ensino <span>{teaching.length}</span></a>
      <a href="#pesquisa">Projetos <span>{projects.length}</span></a>
      <a href="#orientacoes">Orientações <span>{supervision.length}</span></a>
      {currentActivities.length > 0 && <a href="#outras-atividades">Outras atividades <span>{currentActivities.length}</span></a>}
    </nav>
  </section>

  <div class="academic-directory now-directory">
    <section class="section container" id="ensino">
      <SectionHeading title="Ensino" linkLabel="Disciplinas e histórico →" linkHref={withBase('/ensino/')} />
      {teaching.length ? semesters.map((semester) => <section class="record-group semester-group">
        <h3>{semester}</h3>
        <div class="teaching-list">{teaching.filter((entry) => entry.data.semester === semester).map((entry) => <TeachingCard teaching={entry} showSemester={false} headingLevel="h4" />)}</div>
      </section>) : <p class="empty-state">Nenhuma oferta atual publicada.</p>}
    </section>

    <section class="section container" id="pesquisa">
      <SectionHeading title="Projetos" linkLabel="Todos os projetos →" linkHref={withBase('/projetos/')} />
      {projects.length ? <div class="record-group editorial-list project-list">{projects.map((entry) => <ProjectCard project={entry} />)}</div> : <p class="empty-state">Nenhum projeto em andamento publicado.</p>}
    </section>

    <section class="section container" id="orientacoes">
      <SectionHeading title="Orientações" linkLabel="Todas as orientações →" linkHref={withBase('/orientacoes/')} />
      {supervision.length ? supervisionTypes.map((type) => <section class="record-group">
        <h3>{formatSupervisionType(type)}</h3>
        <ul class="supervision-list">{supervision.filter((entry) => entry.data.type === type).map((entry) => <SupervisionItem supervision={entry} peopleFirst={true} />)}</ul>
      </section>) : <p class="empty-state">Nenhuma orientação atual publicada.</p>}
    </section>

    {currentActivities.length > 0 && <section class="section container" id="outras-atividades">
      <SectionHeading title="Outras atividades" />
      <div class="record-group"><ul class="home-list">
        {currentActivities.map((activity) => <li><h3>{activity.title}</h3><p>{activity.description}</p></li>)}
      </ul></div>
    </section>}
  </div>
</BaseLayout>
