---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileSidebar from '@/components/ProfileSidebar.astro';
import Biography from '@/components/Biography.astro';
import PartnerLogos from '@/components/PartnerLogos.astro';
import { site } from '@/data/site';
import { getPublications } from '@/lib/bibtex';
import { getCurrentAcademicActivities, publicField } from '@/lib/current';
import { formatProjectType, projectRoleLabel, withBase } from '@/lib/site';

const { projects, teaching, supervision } = await getCurrentAcademicActivities();
const teachingOrder = new Map(site.homeTeachingOrder.map((id, index) => [id, index]));
const homeTeaching = [...teaching].sort((a, b) =>
  (teachingOrder.get(a.id) ?? Infinity) - (teachingOrder.get(b.id) ?? Infinity));
const currentSupervisions = supervision.slice(0, 3);
const recentPublications = getPublications().filter((publication) => publication.year && Number(publication.year) >= new Date().getFullYear() - 1).slice(0, 2);
const semesters = [...new Set(teaching.map((entry) => entry.data.semester))];
---

<BaseLayout title="Início">
  <div class="container home">
    <ProfileSidebar />
    <div class="home-content">
      <section class="home-panel home-about" aria-labelledby="apresentacao-title">
        <div class="panel-heading">
          <h2 id="apresentacao-title">Sobre mim</h2>
          <div class="home-about-links">
            <a href={withBase('/sobre/')}>Sobre minha trajetória →</a>
            <a href={withBase('/agora/')}>O que estou fazendo agora →</a>
          </div>
        </div>
        <Biography />
      </section>

      <section class="home-panel" aria-labelledby="pesquisa-title">
        <div class="panel-heading"><h2 id="pesquisa-title">Projetos em andamento</h2><a href={withBase('/projetos/')}>Todos os projetos →</a></div>
        <div class="home-entries">
          {projects.map((project) => <article class="home-entry home-project-entry">
            <div class="project-card-body">
            <h3><a href={withBase(`/projetos/${project.id}/`)}>{project.data.title}</a></h3>
            {project.data.description && <p>{project.data.description}</p>}
            <p class="entry-note">{formatProjectType(project.data.type)} · {projectRoleLabel(project.id, project.data.role)}</p>
            </div>
            <PartnerLogos partners={[...new Set([...project.data.partners, ...project.data.funding])]} />
          </article>)}
        </div>
      </section>

      <section class="home-panel home-teaching" aria-labelledby="ensino-title">
        <div class="panel-heading"><h2 id="ensino-title">Ensino {semesters.length === 1 && <span class="heading-note">{semesters[0]}</span>}</h2><a href={withBase('/ensino/')}>Disciplinas e histórico →</a></div>
        <ul class="home-list home-course-list">
          {homeTeaching.map((entry) => <li>
            <h3><a href={entry.data.site || withBase('/ensino/')} {...(entry.data.site ? { target: '_blank', rel: 'noreferrer' } : {})}>{entry.data.title}{entry.data.site && '\u00a0↗'}</a></h3>
            <p>{publicField(entry.data.course)}{semesters.length > 1 && ` · ${entry.data.semester}`}</p>
          </li>)}
        </ul>
      </section>

      {recentPublications.length > 0 && <section class="home-panel" aria-labelledby="publicacoes-title">
        <div class="panel-heading"><h2 id="publicacoes-title">Publicações recentes</h2><a href={withBase('/publicacoes/')}>Ver publicações →</a></div>
        <div class="home-entries">
          {recentPublications.map((publication) => <article class="home-entry">
            <h3><a href={withBase(`/publicacoes/#${publication.key}`)}>{publication.title}</a></h3>
            <p>{[publication.venue, publication.year].filter(Boolean).join(' · ')}</p>
          </article>)}
        </div>
      </section>}

      {currentSupervisions.length > 0 && <section class="home-panel" aria-labelledby="orientacoes-title">
        <div class="panel-heading"><h2 id="orientacoes-title">Orientações em andamento</h2><a href={withBase('/orientacoes/')}>Ver todas ({supervision.length}) →</a></div>
        <ul class="home-list">
          {currentSupervisions.map((entry) => <li>
            <h3><a href={withBase(`/orientacoes/#${entry.id}`)}>{entry.data.students.join(' · ')}</a></h3>
            <p>{entry.data.title}</p>
          </li>)}
        </ul>
      </section>}
    </div>
  </div>
</BaseLayout>
