---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SupervisionItem from '@/components/SupervisionItem.astro';
import ArchiveYear from '@/components/ArchiveYear.astro';
import { groupByYear } from '@/lib/archive';

const supervisions = await getCollection('supervision');
const mostRecentTime = (entry: typeof supervisions[number]) => {
  const date = entry.data.defense?.date ?? entry.data.qualification?.date ?? entry.data.end ?? entry.data.start;
  if (date) return date.getTime();
  const year = entry.data.semester?.slice(0, 4) ?? entry.data.year;
  return year ? Date.UTC(Number(year), entry.data.semester?.endsWith('.2') ? 6 : 0) : 0;
};
const byMostRecent = (a: typeof supervisions[number], b: typeof supervisions[number]) =>
  mostRecentTime(b) - mostRecentTime(a) || a.data.title.localeCompare(b.data.title, 'pt-BR');
const current = supervisions.filter((entry) => entry.data.status === 'current' || entry.data.status === 'planned').sort(byMostRecent);
const completed = supervisions.filter((entry) => entry.data.status === 'completed' || entry.data.status === 'archived').sort(byMostRecent);
const categoryFor = (entry: typeof supervisions[number]) => {
  if (entry.data.title.toLocaleLowerCase('pt-BR').includes('estágio')) return 'Estágio';
  if (entry.data.type === 'monitoria') return 'Monitoria';
  if (entry.data.type === 'mestrado') return 'Mestrado';
  if (entry.data.type === 'TCC') return /técnico|^informática$/i.test(entry.data.course ?? '') ? 'TCC (Técnico)' : 'TCC (Superior)';
  if (entry.data.type === 'competicao') return 'Competições';
  if (entry.data.type === 'outro' && entry.data.course === 'Informática') return 'TCC (Técnico)';
  return 'Pesquisa';
};
const categoryOrder = ['Mestrado', 'TCC (Superior)', 'TCC (Técnico)', 'Monitoria', 'Pesquisa', 'Estágio', 'Competições'];
const currentGroups = categoryOrder.map((label) => ({ label, entries: current.filter((entry) => categoryFor(entry) === label) })).filter((group) => group.entries.length);
const completedGroups = groupByYear(completed, (entry) => {
  const timestamp = mostRecentTime(entry);
  return timestamp ? new Date(timestamp).getUTCFullYear() : undefined;
});
---

<BaseLayout title="Orientações" description="Orientações acadêmicas e projetos acompanhados por Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Orientações</h1>
    <p>Trabalhos acompanhados no ensino técnico, na graduação e na pós-graduação.</p>
    <nav class="page-shortcuts" aria-label="Orientações por período">
      <a href="#em-andamento">Em andamento <span>{current.length}</span></a>
      <a href="#concluidas">Concluídas <span>{completed.length}</span></a>
    </nav>
  </section>

  <section class="section container academic-directory" id="em-andamento">
    <SectionHeading title="Em andamento" />
    {currentGroups.length ? currentGroups.map((group) => <section class="record-group">
      <h3>{group.label}</h3>
      <ul class="supervision-list">{group.entries.map((entry) => <SupervisionItem supervision={entry} peopleFirst={true} />)}</ul>
    </section>) : <p class="empty-state">Nenhuma orientação atual publicada.</p>}
  </section>

  <section class="section container academic-directory" id="concluidas">
    <SectionHeading title="Concluídas" />
    {completedGroups.map(([year, entries]) => <ArchiveYear year={year} count={entries.length}>
      {categoryOrder.map((label) => ({ label, entries: entries.filter((entry) => categoryFor(entry) === label) })).filter((group) => group.entries.length).map((group) => <section class="record-group">
        <h3>{group.label}</h3>
        <ul class="supervision-list">{group.entries.map((entry) => <SupervisionItem supervision={entry} peopleFirst={true} />)}</ul>
      </section>)}
    </ArchiveYear>)}
  </section>
</BaseLayout>
