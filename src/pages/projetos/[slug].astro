---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import SupervisionItem from '@/components/SupervisionItem.astro';
import { getPublications } from '@/lib/bibtex';
import { formatProjectPeriod, formatProjectType, formatStatus, withBase } from '@/lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const coordinators = data.team?.coordinators ?? [];
const participants = data.team?.participants ?? [];
const publications = getPublications().filter((publication) =>
  publication.project === project.id || data.related?.publications.includes(publication.key),
);
const allSupervisions = await getCollection('supervision');
const supervisions = allSupervisions.filter((supervision) =>
  supervision.data.project === project.id || data.related?.supervisions.includes(supervision.id),
);
---

<BaseLayout title={data.title} description={data.description}>
  <article class="detail-page container">
    <a class="back-link" href={withBase('/projetos/')}>← Todos os projetos</a>
    <header class="detail-header reading-width">
      <div class="card-topline"><span class="tag">{formatProjectType(data.type)}</span><span class={`status status-${data.status}`}>{formatStatus(data.status)}</span></div>
      <h1>{data.title}</h1>
      <p class="detail-lede">{data.description}</p>
    </header>

    <section class="detail-section reading-width" aria-labelledby="sobre-projeto">
      <h2 id="sobre-projeto">Sobre o projeto</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="detail-section reading-width" aria-labelledby="informacoes-projeto">
      <h2 id="informacoes-projeto">Informações</h2>
      <dl class="detail-facts">
        <div><dt>Papel</dt><dd>{data.role}</dd></div>
        <div><dt>Período</dt><dd>{formatProjectPeriod(data.start, data.end)}</dd></div>
        <div><dt>Status</dt><dd>{formatStatus(data.status)}</dd></div>
        <div><dt>Tipo</dt><dd>{formatProjectType(data.type)}</dd></div>
        {data.participation && <div><dt>Participação</dt><dd>{formatProjectPeriod(data.participation.start, data.participation.end)}</dd></div>}
        <div><dt>Áreas</dt><dd>{data.areas.join(' · ')}</dd></div>
        {data.institutions.length > 0 && <div><dt>Instituições</dt><dd>{data.institutions.join(' · ')}</dd></div>}
        {data.partners.length > 0 && <div><dt>Parceiros</dt><dd>{data.partners.join(' · ')}</dd></div>}
        {data.program && <div><dt>Programa</dt><dd>{data.program}</dd></div>}
        {data.funding.length > 0 && <div><dt>Fomento</dt><dd>{data.funding.join(' · ')}</dd></div>}
        {coordinators.length > 0 && <div><dt>Coordenação</dt><dd>{coordinators.join(' · ')}</dd></div>}
        {participants.length > 0 && <div><dt>Participantes</dt><dd>{participants.join(' · ')}</dd></div>}
      </dl>
    </section>

    {(data.links && Object.values(data.links).some(Boolean)) || data.sources.length > 0 ? <section class="detail-section reading-width" aria-labelledby="links-projeto">
      <h2 id="links-projeto">Links relacionados</h2>
      <ul class="detail-link-list">
        {data.links?.project && <li><a href={data.links.project} target="_blank" rel="noreferrer">Página do projeto ↗</a></li>}
        {data.links?.repository && <li><a href={data.links.repository} target="_blank" rel="noreferrer">Repositório ↗</a></li>}
        {data.links?.demo && <li><a href={data.links.demo} target="_blank" rel="noreferrer">Demonstração ↗</a></li>}
        {data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}
      </ul>
    </section> : null}

    {publications.length > 0 && <section class="detail-section reading-width" aria-labelledby="publicacoes-projeto">
      <h2 id="publicacoes-projeto">Publicações</h2>
      <ul class="publication-list">{publications.map((publication) => <PublicationItem publication={publication} />)}</ul>
    </section>}

    {supervisions.length > 0 && <section class="detail-section reading-width" aria-labelledby="orientacoes-projeto">
      <h2 id="orientacoes-projeto">Orientações</h2>
      <ul class="supervision-list">{supervisions.map((supervision) => <SupervisionItem supervision={supervision} />)}</ul>
    </section>}
  </article>
</BaseLayout>
