---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = await getCollection('projects');
const byLatest = (a: (typeof projects)[number], b: (typeof projects)[number]) => {
  if (a.data.featured !== b.data.featured) {
    return Number(b.data.featured) - Number(a.data.featured);
  }
  const timeA = (a.data.end ?? a.data.start)?.getTime() ?? Date.UTC(a.data.year!, 0);
  const timeB = (b.data.end ?? b.data.start)?.getTime() ?? Date.UTC(b.data.year!, 0);
  return timeB - timeA || a.data.title.localeCompare(b.data.title, 'pt-BR');
};

const current = projects
  .filter((entry) => entry.data.status === 'active' || entry.data.status === 'planned')
  .sort(byLatest);

const completed = projects
  .filter((entry) => entry.data.status === 'completed' || entry.data.status === 'archived')
  .sort(byLatest);
---

<BaseLayout title="Projetos" description="Projetos de pesquisa, extensão, inovação e desenvolvimento tecnológico de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Projetos</h1>
    <p>Iniciativas de pesquisa, extensão, desenvolvimento tecnológico e inovação, desenvolvidas em colaboração com instituições de ensino, centros de pesquisa e parceiros do setor produtivo.</p>
    <nav class="page-shortcuts" aria-label="Projetos por período">
      <span class="shortcuts-label">Projetos</span>
      <a href="#em-andamento">Em andamento <span>{current.length}</span></a>
      <a href="#concluidos">Concluídos <span>{completed.length}</span></a>
    </nav>
  </section>

  <div class="academic-directory">
  <section class="section container" id="em-andamento">
    <SectionHeading title="Em andamento" />
    <div class="record-group editorial-list project-list">
      {current.length ? (
        current.map((project) => <ProjectCard project={project} />)
      ) : (
        <div class="empty-state">
          <p>Nenhum projeto em andamento publicado no momento.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section-soft" id="concluidos">
    <div class="container">
      <SectionHeading title="Concluídos" />
      <div class="record-group editorial-list project-list">
        {completed.length ? (
          completed.map((project) => <ProjectCard project={project} />)
        ) : (
          <div class="empty-state">
            <p>Ainda não há projetos concluídos publicados.</p>
          </div>
        )}
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
