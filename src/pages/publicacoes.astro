---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { getPublications } from '@/lib/bibtex';

const publications = getPublications();
const selected = publications.filter((publication) => publication.selected);
const byType = publications.reduce<Record<string, typeof publications>>((groups, publication) => {
  groups[publication.type] ??= [];
  groups[publication.type].push(publication);
  return groups;
}, {});
const typeLabels: Record<string, string> = {
  article: 'Artigos',
  conference: 'Trabalhos em eventos',
  chapter: 'Capítulos',
  software: 'Software',
  dataset: 'Conjuntos de dados',
  preprint: 'Preprints',
};
const availableTypes = Object.keys(typeLabels).filter((type) => (byType[type]?.length ?? 0) > 0);
---

<BaseLayout title="Publicações" description="Produção selecionada de Ígor Barbosa da Costa.">
  <section class="page-intro container">
    <h1>Publicações</h1>
  </section>

  <section class="section container">
    <SectionHeading title="Selecionadas" />
    {selected.length ? <ul class="publication-list">{selected.map((publication) => <PublicationItem publication={publication} />)}</ul> : <div class="empty-state"><p>Nenhuma publicação selecionada no momento.</p></div>}
  </section>

  <section class="section section-soft">
    <div class="container">
      <SectionHeading title="Por tipo de produção" />
      <dl class="production-index">
        {availableTypes.map((type) => <div><dt>{typeLabels[type]}</dt><dd>{String(byType[type]?.length ?? 0).padStart(2, '0')}</dd></div>)}
      </dl>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-bibtex]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copyBibtex;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const label = button.querySelector<HTMLElement>('.copy-text');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copiado!';
          button.classList.add('copied');
          setTimeout(() => {
            label.textContent = original;
            button.classList.remove('copied');
          }, 2000);
        }
      } catch (err) {
        console.error('Falha ao copiar citação BibTeX', err);
      }
    });
  });
</script>
